# Copy to .env for local development. For production use `wrangler secret put <NAME>`.

# Signs session cookies and tokens. Any long random string.
SESSION_SECRET=change-me

# Local-only overrides of the vars in wrangler.jsonc
DEV_IDENTITIES=true

# Discord Activity sign-in (Developer Portal -> OAuth2). The ID is public, the secret is not.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# To judge answers with TypeSafe Jev instead of Workers AI Clef
# GRADER=jev
# JEV_KEY=
# JEV_MODEL=jev-latest
# JEV_THRESHOLD=0.7

# To judge answers with OpenAI instead
# GRADER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
